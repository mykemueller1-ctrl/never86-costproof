# Copy to .env locally. Never commit actual credentials.
HOST=127.0.0.1
PORT=4317
METERLESS_BASE_URL=http://127.0.0.1:8088/v1
METERLESS_RUNTIME_TOKEN=
METERLESS_MODEL=meterless/auto
# Zetaris REST mapping must be validated against the running vendor version.
ZETARIS_BASE_URL=http://127.0.0.1:8888/api/v1.0
ZETARIS_API_KEY=
ZETARIS_ORG_ID=1
# Create this only after real source, columns and returned rows are reviewed.
ZETARIS_MAPPING_PROOF_PATH=.costproof/zetaris-mapping.json
# Optional table overrides must match that proof exactly.
# ZETARIS_TABLE_SALES=costproof.sales
# ZETARIS_TABLE_LABOR=costproof.labor
# ZETARIS_TABLE_POLICY=costproof.policy
